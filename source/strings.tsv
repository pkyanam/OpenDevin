105d41b03	604	-- Add `hidden` flag to mark sessions that should not appear in user-facing\n-- session views (REPL `--list`, `--continue`, prefix resolution, and the\n-- default ACP agent's `session/list`). Internal helper agents (e.g. the\n-- summarizer) set this to 1 when persisting sessions. All existing rows\n-- default to 0 (not hidden).\n--\n-- Hidden sessions are still loadable by ID via ACP `session/load` so that\n-- helper agents can restore incremental state across restarts.\nALTER TABLE sessions ADD COLUMN hidden INTEGER NOT NULL DEFAULT 0;\n\nCREATE INDEX IF NOT EXISTS idx_sessions_hidden ON sessions(hidden);\n
